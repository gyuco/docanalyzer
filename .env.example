# Copia in `.env` e adatta. Tutte le variabili sono opzionali: i valori qui
# sotto sono i default definiti in src/docanalyzer/config.py.
# Le API key dei provider cloud NON hanno il prefisso DOCANALYZER_: le leggono
# direttamente gli SDK dall'ambiente.

# --------------------------------------------------------------------- #
# Backend LLM
# --------------------------------------------------------------------- #

# Uno di: ollama | anthropic | openai
DOCANALYZER_BACKEND=ollama

# Nome del modello. Omettendolo vale il default del backend scelto:
#   ollama    -> gemma4:e4b
#   anthropic -> claude-sonnet-5
#   openai    -> gpt-4o-mini
DOCANALYZER_MODEL=gemma4:e4b

# Solo backend ollama.
DOCANALYZER_OLLAMA_HOST=http://localhost:11434

# Solo backend anthropic. Richiede: uv sync --extra anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Solo backend openai. Richiede: uv sync --extra openai
# OPENAI_API_KEY=sk-...
# Puntando OPENAI_BASE_URL a un server locale OpenAI-compatibile (vLLM,
# LM Studio, llama.cpp server) il backend `openai` serve anche modelli locali.
# OPENAI_BASE_URL=http://localhost:8000/v1

# --------------------------------------------------------------------- #
# Inferenza
# --------------------------------------------------------------------- #

DOCANALYZER_TEMPERATURE=0.0

# Finestra di contesto richiesta a Ollama. 32k su 16 GB di RAM unificata è già
# oneroso: alzalo solo se il modello ci sta.
DOCANALYZER_NUM_CTX=32768

# Limite di caratteri passati al modello, oltre il quale si tronca.
# ~4 char/token, quindi 60k char ~ 15k token: lascia spazio a prompt e output.
DOCANALYZER_MAX_INPUT_CHARS=60000

# Timeout in secondi delle chiamate al backend.
DOCANALYZER_REQUEST_TIMEOUT=600

# --------------------------------------------------------------------- #
# Servizio HTTP (usate solo da docanalyzer.api)
# --------------------------------------------------------------------- #

# Database dei job e file caricati. Un solo posto da montare come volume e da
# mettere nei backup. Deve essere lo stesso per API e worker.
DOCANALYZER_DATA_DIR=./data

# Un PDF oltre questa soglia o è un errore o è un batch travestito.
DOCANALYZER_MAX_UPLOAD_MB=50

# Dopo quante ore job e file caricati vengono cancellati.
DOCANALYZER_JOB_RETENTION_HOURS=24

# Chiave condivisa richiesta nell'header X-API-Key.
# Vuota = nessun controllo: accettabile solo in locale.
DOCANALYZER_API_KEY=

# Intervallo di polling della coda quando è vuota.
DOCANALYZER_WORKER_POLL_SECONDS=1.0

# Tentativi per job prima di dichiararlo definitivamente fallito.
DOCANALYZER_MAX_ATTEMPTS=2
